{
  "manifest_version": 2,
  "name": "Ticket Desk Links",
  "version": "0.9.0",
  "description": "Opens Jira ticket links in the Ticket Desk desktop app. Other links are left alone.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "@ticketdesk-links",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["links.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["links.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html"
  },
  "permissions": ["nativeMessaging", "storage"]
}
