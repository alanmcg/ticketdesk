pkgname=ticketdesk
pkgver=0.10.0
pkgrel=1
pkgdesc='Fast GNOME client for Jira Cloud'
arch=('any')
url='https://github.com/USER/ticketdesk'
license=('GPL-2.0-or-later')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita' 'libsecret' 'webkitgtk-6.0')
makedepends=('meson')
checkdepends=('appstream' 'desktop-file-utils')
optdepends=('gnome-keyring: store the API token')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # replace with the real checksum when publishing (updpkgsums)

build() {
  arch-meson "$pkgname-$pkgver" build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}
